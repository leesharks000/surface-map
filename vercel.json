{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "surfacemap.org"
        }
      ],
      "destination": "https://www.surfacemap.org/:path*",
      "permanent": true
    }
  ]
}